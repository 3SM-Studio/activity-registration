{
  "name": "activity-registration",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --write src/infrastructure/google/operator-sheet-runtime.ts tests/unit/operator-sheet-runtime.test.ts && git diff -- src/infrastructure/google/operator-sheet-runtime.ts tests/unit/operator-sheet-runtime.test.ts && false",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:integration:sheets": "tsx scripts/test-sheets-integration.ts",
    "check": "pnpm repo:validate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "prod:env:validate": "tsx scripts/validate-production-env.ts",
    "sheet:bootstrap": "tsx scripts/sheet-bootstrap.ts",
    "sheet:schema-sync": "tsx scripts/sheet-schema-sync.ts",
    "sheet:validate": "tsx scripts/sheet-validate.ts",
    "sheet:migrate": "tsx scripts/sheet-migrate.ts",
    "seed:test": "tsx scripts/seed-test.ts && tsx scripts/sheet-schema-sync.ts",
    "seed:production-catalog": "tsx scripts/seed-production-catalog.ts && tsx scripts/sheet-schema-sync.ts",
    "diagnostics": "tsx scripts/diagnostics.ts",
    "registrations:reconcile": "tsx scripts/reconcile-registrations.ts",
    "retention:report": "tsx scripts/retention-report.ts",
    "repo:validate": "node scripts/repo-validate.mjs",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@hookform/resolvers": "5.6.0",
    "@vercel/oidc": "3.8.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "google-auth-library": "11.0.0",
    "libphonenumber-js": "1.13.11",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-email": "6.9.1",
    "react-hook-form": "7.84.0",
    "react-icons": "5.7.0",
    "react-phone-number-input": "3.4.17",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "shadcn": "4.18.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
