# Runtime mode
APP_ENV=test
DATA_BACKEND=memory

# Google Sheets, required when DATA_BACKEND=google-sheets
GOOGLE_SPREADSHEET_ID=

# Production on Vercel: OIDC -> Google Workload Identity Federation
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# Explicit guard for writing synthetic fixtures to TEST
ALLOW_TEST_SEED=false
