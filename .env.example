# Runtime mode
APP_ENV=test
DATA_BACKEND=memory

# Google Sheets, required when DATA_BACKEND=google-sheets.
# Canonical PROD spreadsheet created for v3:
# 1DRcWvY8xfZDGjJLWOr8Ax1XsyBw4dWU8C6u9WGNvFfM
GOOGLE_SPREADSHEET_ID=

# Email notifications. Production requires Resend.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
# Production must use a sender on a domain verified in Resend, for example:
# EMAIL_FROM=Pracownia Twórcza Pozytywka <zapisy@pozytywka.example>
EMAIL_FROM=Pracownia Twórcza Pozytywka <zapisy@example.com>
# Canonical Pozytywka operational mailbox for registration notifications.
REGISTRATION_ADMIN_EMAILS=pozytywka.boleslaw@gmail.com

# Production on Vercel: OIDC -> Google Workload Identity Federation
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# Explicit guard for writing synthetic fixtures to TEST.
ALLOW_TEST_SEED=false

# One-time initial PROD catalog guard. Keep false during normal runtime.
# The seed also requires APP_ENV=production, the exact canonical PROD Sheet ID
# and an empty ZAPISY table.
ALLOW_PRODUCTION_CATALOG_SEED=false
